[Unit]
Description=Start/Stop Unoserver
Requires=systemd-modules-load.service
After=network.target systemd-modules-load.service

[Service]
Type=simple
# Benutzer und Gruppe anpassen
User=te
Group=te
# Bei Bedarf Verzeichnisse anpassen
ExecStart=/usr/bin/bash -c 'cd $HOME/.unoserver/bin; ./python ./unoserver;'
# Unoserver im Netzwerk nutzen
# ExecStart=/usr/bin/bash -c 'cd $HOME/.unoserver/bin; ./python ./unoserver --interface 0.0.0.0;'
ExecStartPost=/usr/bin/bash -c 'cd $HOME/.unoserver; ps ax | grep "./unoserver" | grep -v grep|cut -c 1-8 | sed "s/ *$//g" | sed "s/^ *//g"> unoserver.pid;'
ExecStop=/usr/bin/bash -c 'cd $HOME/.unoserver; /usr/bin/pkill -F unoserver.pid && rm unoserver.pid;'
RestartSec=5

[Install]
WantedBy=multi-user.target
